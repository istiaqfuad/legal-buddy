HF_TOKEN=

POSTGRES_CONNECTION_STRING=
QDRANT_VECTORESTORE=http://qdrant:6333

LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=
LANGSMITH_API_KEY=

QDRANT_API_KEY=

GEMINI_API_KEY=

EMBEDDING_MODEL=
# Optional: override the embedding model's max token window (default = model's own).
# Only set if you know the checkpoint supports a larger window than it advertises.
EMBEDDING_MAX_TOKENS=

GROQ_API_KEY=

# Custom Azure/Local vLLM Model (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEON_STORAGE_BUCKET=legalbucket

# Neon Auth endpoint for apps/web, including the /neondb/auth path.
# Used when NEON_AUTH_BASE_URL is not set.
AUTH_URL=
# JWKS endpoint used to verify Neon Auth tokens
# (AUTH_URL + /.well-known/jwks.json).
JWKS_URL=

# --- apps/web ---
# Postgres connection string for the Neon project. The web app also accepts
# POSTGRES_CONNECTION_STRING as a fallback. Both must use the pooled
# (...-pooler...) host when the app runs as a container.
DATABASE_URL=
# Neon Auth (Console → Auth → Configuration).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_NEON_AUTH_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# FastAPI service. Inside docker-compose the web container uses http://api:8000.
API_URL=http://localhost:8000
